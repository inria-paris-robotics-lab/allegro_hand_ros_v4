<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="allegro_hand">

    <xacro:include filename="$(find allegro_hand_description)/description/allegro_hand_ros2_control.xacro" />

    <xacro:macro name="allegro_hand" params="chirality parent *origin prefix real_hardware:=false ur5_attachment:=false desk_stand:=false standalone:=false">

        <!-- ======================== CHIRALITY PARAMS ========================= -->
        <xacro:property name="suffix" value="${chirality}"/>
        <xacro:property name="minus_left"  value="${-1 if suffix == 'left' else  1}"/>
        <xacro:property name="minus_right" value="${-1 if suffix == 'right' else  1}"/>
        <xacro:property name="zero_left"   value="${0 if suffix == 'left' else 1}"/>
        <xacro:property name="zero_right"  value="${0 if suffix == 'right' else 1}"/>

        <xacro:if value="${minus_right * minus_left != -1}">
        INVALID CHIRALITY, MUST BE "left" OR "right"
        </xacro:if>

        <xacro:property name="DEG2RAD" value="0.01745329251"/>

        <!-- ======================== BASE PARAMS ========================= -->
        <xacro:property name="palm_link_z" value="0.095"/>
        <xacro:property name="palm_link_x" value="-0.009300"/>
        <xacro:property name="init_pos_file" value="$(find allegro_hand_description)/config/initial_position.yaml"/>


        <!-- ======================== FINGER PARAMS ======================== -->
        <xacro:property name="links_x" value="0.0196"/>
        <xacro:property name="links_y" value="0.0275"/>
        <xacro:property name="link0_z" value="0.0164"/>
        <xacro:property name="link1_z" value="0.0540"/>
        <xacro:property name="link2_z" value="0.0384"/>

        <!-- full height from joint to tip. when used,
        the radius of the finger tip sphere will be subtracted
        and one fixed link will be added for the tip. -->
        <xacro:property name="link3_z" value="0.0387"/>
        <xacro:property name="fingerTip_r" value="0.0120"/>
        <xacro:property name="offset_origin_x_const" value="0"/>
        <xacro:property name="offset_origin_y_const" value="0.0435"/>
        <xacro:property name="offset_origin_z_const" value="-0.001542"/>
        <xacro:property name="offset_origin_z_mid_const" value="0.0007"/>

        <!-- ========================= THUMB PARAMS ========================= -->
        <xacro:property name="link0_t_x" value="0.0358"/>
        <xacro:property name="link0_t_y" value="0.0340"/>
        <xacro:property name="link0_t_z" value="0.0455"/>
        <xacro:property name="link1_t_z" value="0.0177"/>
        <xacro:property name="link2_t_z" value="0.0514"/>
        <xacro:property name="link3_t_z" value="0.0543"/>

        <!-- ========================= LIMITS ========================= -->
        <xacro:property name="joint_safety_margin" value="0.1"/>
        <xacro:property name="limit_0_up" value="0.57"/>
        <xacro:property name="limit_0_low" value="-0.57"/>
        <xacro:property name="limit_1_up" value="1.71"/>
        <xacro:property name="limit_1_low" value="-0.296"/>
        <xacro:property name="limit_2_up" value="1.809"/>
        <xacro:property name="limit_2_low" value="-0.274"/>
        <xacro:property name="limit_3_up" value="1.718"/>
        <xacro:property name="limit_3_low" value=" -0.327"/>
        <xacro:property name="limit_0_t_up" value="1.496"/>
        <xacro:property name="limit_0_t_low" value="0.363"/>
        <xacro:property name="limit_1_t_up" value="1.263"/>
        <xacro:property name="limit_1_t_low" value="-0.205"/>
        <xacro:property name="limit_2_t_up" value="1.744"/>
        <xacro:property name="limit_2_t_low" value="-0.289"/>
        <xacro:property name="limit_3_t_up" value="1.819"/>
        <xacro:property name="limit_3_t_low" value="-0.262"/>

        <!-- ============================= HAND and FINGERS ============================== -->
        <!-- PALM -->
        <link name="${prefix}_palm_link">
            <visual>
                <geometry>
                    <mesh filename="file://$(find allegro_hand_description)/meshes/hand/base_link_${suffix}.stl"/>
                </geometry>
                <material name="black">
                    <color rgba=".2 .2 .2 1"/>
                </material>
            </visual>

            <collision>
                <geometry>
                    <mesh filename="file://$(find allegro_hand_description)/meshes/hand/base_link_${suffix}_collision.stl"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 ${palm_link_z/2}" rpy="0 0 0"/>
                <mass value="4.1685782e-01"/>
                <inertia ixx="1.3752240e-03" ixy="1.1841496e-05" ixz="-2.7306101e-04" 
                iyx= "1.1841496e-05" iyy="1.2103623e-03" iyz="-2.3172379e-06" 
                izx = "-2.7306101e-04" izy = "-2.3172379e-06" izz="6.2229538e-04"/>
            </inertial>
        </link>

        <!-- THUMB MACRO -->
        <xacro:macro name="thumb"
                    params="finger_num offset_origin_x offset_origin_y offset_origin_z finger_angle_r finger_angle_p finger_angle_y">

            <!-- [LINK 12] -->
            <link name="${prefix}_link_${'%02d' % (finger_num*4+0)}">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_12_${suffix}.stl"/>
                    </geometry>
                    <material name="black">
                        <color rgba=".2 .2 .2 1"/>
                    </material>
                    <origin rpy="${zero_right * 180*DEG2RAD} 0 0" xyz="0 0 0"/>
                </visual>

                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_12_${suffix}_collision.stl"/>
                    </geometry>
                    <origin rpy="${zero_right * 180*DEG2RAD} 0 0" xyz="0 0 0"/>
                </collision>

                <inertial>
                    <mass value="7.9809876e-02"/>
                    <inertia ixx="4.7114004e-05" ixy="-8.5650686e-06" ixz="-5.1403625e-06" 
                    iyx= "-8.5650686e-06" iyy="2.9419559e-05" iyz="-1.2569682e-05" 
                    izx = "-5.1403625e-06" izy = "-1.2569682e-05" izz="4.0511157e-05"/>
                </inertial>
            </link>

            <joint name="${prefix}_joint_${'%02d' % (finger_num*4+0)}" type="revolute">
                <axis xyz="${minus_right} 0 0"/>
                <limit effort="0.71" velocity="9.5"
                    lower="${limit_0_t_low+joint_safety_margin}"
                    upper="${limit_0_t_up-joint_safety_margin}"/>
                <parent link="${prefix}_palm_link"/>
                <child link="${prefix}_link_${'%02d' % (finger_num*4+0)}"/>
                <origin rpy="${finger_angle_r} ${finger_angle_p} ${finger_angle_y}"
                        xyz="${offset_origin_x} ${offset_origin_y} ${offset_origin_z}"/>
                <dynamics damping="0.1" friction="0.01"/>
            </joint>

            <!-- [LINK 13] -->
            <link name="${prefix}_link_${'%02d' % (finger_num*4+1)}">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_13.stl"/>
                    </geometry>
                    <material name="black">
                        <color rgba=".2 .2 .2 1"/>
                    </material>
                </visual>

                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_13_collision.stl"/>
                    </geometry>
                </collision>

                <inertial>
                    <mass value="1.1350110e-02"/>
                    <inertia ixx="2.7007029e-06" ixy="3.1772015e-09" ixz="-9.9625696e-09" 
                    iyx= "3.1772015e-09" iyy="2.0578543e-06" iyz="4.1823243e-09" 
                    izx = "-9.9625696e-09" izy = "4.1823243e-09" izz=" 1.2713693e-06"/>
                </inertial>
            </link>

            <joint name="${prefix}_joint_${'%02d' % (finger_num*4+1)}" type="revolute">
                <axis xyz="0 0 ${minus_left}"/>
                <limit effort="0.71" velocity="9.5"
                    lower="${limit_1_t_low+joint_safety_margin}"
                    upper="${limit_1_t_up-joint_safety_margin}"/>
                <parent link="${prefix}_link_${'%02d' % (finger_num*4+0)}"/>
                <child link="${prefix}_link_${'%02d' % (finger_num*4+1)}"/>
                <origin xyz="-0.027 ${minus_left * 0.005} 0.0399"/>
                <dynamics damping="0.1" friction="0.01"/>
            </joint>

            <!-- [LINK 14] -->
            <link name="${prefix}_link_${'%02d' % (finger_num*4+2)}">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_14.stl"/>
                    </geometry>
                    <material name="black">
                        <color rgba=".2 .2 .2 1"/>
                    </material>
                </visual>

                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_14_collision.stl"/>
                    </geometry>
                </collision>

                <inertial>
                    <mass value="4.0206693e-02"/>
                    <inertia ixx="4.3413941e-06" ixy="9.6355047e-07" ixz="-3.9856829e-07" 
                    iyx= "9.6355047e-07" iyy="2.1797267e-05" iyz="-1.2313988e-08" 
                    izx = "-3.9856829e-07" izy = "-1.2313988e-08" izz="2.0281187e-05"/>
                </inertial>
            </link>

            <joint name="${prefix}_joint_${'%02d' % (finger_num*4+2)}" type="revolute">
                <axis xyz="0 1 0"/>
                <limit effort="0.71" velocity="9.5"
                    lower="${limit_2_t_low+joint_safety_margin}"
                    upper="${limit_2_t_up-joint_safety_margin}"/>
                <parent link="${prefix}_link_${'%02d' % (finger_num*4+1)}"/>
                <child link="${prefix}_link_${'%02d' % (finger_num*4+2)}"/>
                <origin xyz="0 0 ${link1_t_z}"/>
                <dynamics damping="0.1" friction="0.01"/>
            </joint>

            <!-- [LINK 15] -->
            <link name="${prefix}_link_${'%02d' % (finger_num*4+3)}">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_15.stl"/>
                    </geometry>
                    <material name="black">
                        <color rgba=".2 .2 .2 1"/>
                    </material>
                </visual>

                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_15_collision.stl"/>
                    </geometry>
                </collision>

                <inertial>
                    <mass value=" 4.0750131e-02"/>
                    <inertia ixx=" 3.9420540e-06" ixy="5.6337647e-07" ixz="-5.3566170e-08" 
                    iyx= "   5.6337647e-07" iyy=" 1.6474691e-05" iyz="-1.8757848e-08" 
                    izx = " -5.3566170e-08" izy = "-1.8757848e-08" izz="1.5477224e-05"/>
                </inertial>
            </link>

            <joint name="${prefix}_joint_${'%02d' % (finger_num*4+3)}" type="revolute">
                <axis xyz="0 1 0"/>
                <limit effort="0.71" velocity="9.5"
                    lower="${limit_3_t_low+joint_safety_margin}"
                    upper="${limit_3_t_up-joint_safety_margin}"/>
                <parent link="${prefix}_link_${'%02d' % (finger_num*4+2)}"/>
                <child link="${prefix}_link_${'%02d' % (finger_num*4+3)}"/>
                <origin xyz="0 0 ${link2_t_z}"/>
                <dynamics damping="0.1" friction="0.01"/>
            </joint>

            <!-- [FINGER TIP] -->
            <link name="${prefix}_link_${'%02d' % (finger_num*4+3)}_tip">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_15_tip.stl"/>
                    </geometry>
                    <material name="white">
                        <color rgba=".9 .9 .9 1"/>
                    </material>
                </visual>

                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_15_tip_collision.stl"/>
                    </geometry>
                </collision>

                <inertial>
                    <origin xyz="0 0 0" rpy="0 0 0"/>
                    <mass value="1.6654268e-02"/>
                    <inertia ixx=" 1.4702815e-06" ixy=" 0.0000000e+00" ixz="0.0000000e+00" 
                    iyx= "0.0000000e+00" iyy= " 3.8502616e-06" iyz="0.0000000e+00" 
                    izx = "0.0000000e+00" izy = "0.0000000e+00" izz="3.8502616e-06"/>
                </inertial>
            </link>

            <joint name="${prefix}_joint_${'%02d' % (finger_num*4+3)}_tip" type="fixed">
                <parent link="${prefix}_link_${'%02d' % (finger_num*4+3)}"/>
                <child link="${prefix}_link_${'%02d' % (finger_num*4+3)}_tip"/>
                <origin rpy="0 0 0" xyz="0 0 ${link3_t_z-fingerTip_r}"/>
            </joint>
        </xacro:macro>
        <!-- END THUMB MACRO -->

        <!-- THREE FINGER MACRO -->
        <xacro:macro name="finger"
                    params="finger_num offset_origin_x offset_origin_y offset_origin_z finger_angle_r">

            <!-- [LINK 0, 4, 8] -->
            <link name="${prefix}_link_${'%02d' % (finger_num*4+0)}">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_0.stl"/>
                    </geometry>
                    <material name="black">
                        <color rgba=".2 .2 .2 1"/>
                    </material>
                </visual>

                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_0_collision.stl"/>
                    </geometry>
                </collision>

                <inertial>
                    <mass value="1.1350110e-02"/>
                    <inertia ixx="2.7007029e-06" ixy=" 3.1772169e-09" ixz="-9.9625685e-09" 
                    iyx= " 3.1772169e-09" iyy=" 2.0578543e-06" iyz="4.1823243e-09" 
                    izx = "-9.9625685e-09" izy = " 4.1823243e-09" izz="1.2713693e-06"/>
                </inertial>
            </link>

            <joint name="${prefix}_joint_${'%02d' % (finger_num*4+0)}" type="revolute">
                <axis xyz="0 0 1"/>
                <limit effort="0.71" velocity="9.5"
                    lower="${limit_0_low+joint_safety_margin}"
                    upper="${limit_0_up-joint_safety_margin}"/>
                <parent link="${prefix}_palm_link"/>
                <child link="${prefix}_link_${'%02d' % (finger_num*4+0)}"/>
                <origin rpy="${finger_angle_r} 0 0"
                        xyz="${offset_origin_x} ${offset_origin_y} ${offset_origin_z}"/>
                <dynamics damping="0.1" friction="0.01"/>
            </joint>

            <!-- [LINK 1, 5, 9] -->
            <link name="${prefix}_link_${'%02d' % (finger_num*4+1)}">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_1.stl"/>
                    </geometry>
                    <material name="black">
                        <color rgba=".2 .2 .2 1"/>
                    </material>
                </visual>

                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_1_collision.stl"/>
                    </geometry>
                </collision>

                <inertial>
                    <mass value="7.1189096e-02"/>
                    <inertia ixx="7.0483360e-06" ixy=" 2.7238745e-06" ixz="-5.7605847e-07" 
                    iyx= " 2.7238745e-06" iyy=" 7.7935727e-05" iyz="2.1115155e-08" 
                    izx = " -5.7605847e-07" izy = "2.1115155e-08" izz="7.6656552e-05"/>
                </inertial>
            </link>

            <joint name="${prefix}_joint_${'%02d' % (finger_num*4+1)}" type="revolute">
                <limit effort="0.71" velocity="9.5"
                    lower="${limit_1_low+joint_safety_margin}"
                    upper="${limit_1_up-joint_safety_margin}"/>
                <axis xyz="0 1 0"/>
                <parent link="${prefix}_link_${'%02d' % (finger_num*4+0)}"/>
                <child link="${prefix}_link_${'%02d' % (finger_num*4+1)}"/>
                <origin xyz="0 0 ${link0_z}"/>
                <dynamics damping="0.1" friction="0.01"/>
            </joint>

            <!-- [LINK 2, 6, 10]-->
            <link name="${prefix}_link_${'%02d' % (finger_num*4+2)}">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_2.stl"/>
                    </geometry>
                    <material name="black">
                        <color rgba=".2 .2 .2 1"/>
                    </material>
                </visual>

                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_2_collision.stl"/>
                    </geometry>
                </collision>

                <inertial>
                    <mass value="3.7588606e-02"/>
                    <inertia ixx="3.8700419e-06" ixy=" 9.4859852e-07" ixz="-3.4727103e-07" 
                    iyx= "  9.4859852e-07" iyy="  2.9392367e-05" iyz=" 4.1019588e-08" 
                    izx = " -3.4727103e-07" izy = " 4.1019588e-08" izz="2.8178175e-05"/>
                </inertial>
            </link>

            <joint name="${prefix}_joint_${'%02d' % (finger_num*4+2)}" type="revolute">
                <axis xyz="0 1 0"/>
                <limit effort="0.71" velocity="9.5"
                    lower="${limit_2_low+joint_safety_margin}"
                    upper="${limit_2_up-joint_safety_margin}"/>
                <parent link="${prefix}_link_${'%02d' % (finger_num*4+1)}"/>
                <child link="${prefix}_link_${'%02d' % (finger_num*4+2)}"/>
                <origin xyz="0 0 ${link1_z}"/>
                <dynamics damping="0.1" friction="0.01"/>
            </joint>

            <!-- [LINK 3, 7, 11] -->
            <link name="${prefix}_link_${'%02d' % (finger_num*4+3)}">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_3.stl"/>
                    </geometry>
                    <material name="black">
                        <color rgba=".2 .2 .2 1"/>
                    </material>
                </visual>

                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_3_collision.stl"/>
                    </geometry>
                </collision>

                <inertial>
                    <mass value="9.4301124e-03"/>
                    <inertia ixx=" 1.2117405e-06" ixy="9.9624823e-09" ixz="6.9119137e-10" 
                    iyx= "9.9624823e-09" iyy="2.1794983e-06" iyz="3.1772815e-09" 
                    izx = "6.9119137e-10" izy = "3.1772815e-09" izz="1.5590472e-06"/>
                </inertial>
            </link>

            <joint name="${prefix}_joint_${'%02d' % (finger_num*4+3)}" type="revolute">
                <axis xyz="0 1 0"/>
                <limit effort="0.71" velocity="9.5"
                    lower="${limit_3_low+joint_safety_margin}"
                    upper="${limit_3_up-joint_safety_margin}"/>
                <parent link="${prefix}_link_${'%02d' % (finger_num*4+2)}"/>
                <child link="${prefix}_link_${'%02d' % (finger_num*4+3)}"/>
                <origin xyz="0 0 ${link2_z}"/>
                <dynamics damping="0.1" friction="0.01"/>
            </joint>

            <!-- [FINGER TIP] -->
            <link name="${prefix}_link_${'%02d' % (finger_num*4+3)}_tip">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_3_tip.stl"/>
                    </geometry>
                    <material name="white">
                        <color rgba=".9 .9 .9 1"/>
                    </material>
                </visual>

                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/hand/link_3_tip_collision.stl"/>
                    </geometry>
                </collision>

                <inertial>
                    <origin xyz="0 0 0" rpy="0 0 0"/>
                    <mass value="1.6654268e-02"/>
                    <inertia ixx="1.4702815e-06" ixy=" 0.0000000e+00" ixz="0.0000000e+00" 
                    iyx= "0.0000000e+00" iyy= " 3.8502616e-06" iyz="0.0000000e+00" 
                    izx = "0.0000000e+00" izy = "0.0000000e+00" izz="3.8502616e-06"/>
                </inertial>
            </link>

            <joint name="${prefix}_joint_${'%02d' % (finger_num*4+3)}_tip" type="fixed">
                <parent link="${prefix}_link_${'%02d' % (finger_num*4+3)}"/>
                <child link="${prefix}_link_${'%02d' % (finger_num*4+3)}_tip"/>
                <origin rpy="0 0 0" xyz="0 0 ${link3_z-fingerTip_r}"/>
            </joint>
        </xacro:macro>
        <!-- [[END]] THREE FINGER MACRO -->

        <!-- ============================================================================= -->
        <!-- FINGERS -->
        <!-- RIGHT HAND due to which finger is number 0 -->
        <!-- for LEFT HAND switch the sign of the **offset_origin_y** and **finger_angle_r** parameters-->
        <xacro:finger
                finger_num="${zero_right * 2}"
                offset_origin_x="${offset_origin_x_const}"
                offset_origin_y="${offset_origin_y_const}"
                offset_origin_z="${offset_origin_z_const}"
                finger_angle_r="-${5.0*DEG2RAD}"
                />
        <xacro:finger
                finger_num="1"
                offset_origin_x="${offset_origin_x_const}"
                offset_origin_y="0"
                offset_origin_z="${offset_origin_z_mid_const}"
                finger_angle_r="0.0"
                />
        <xacro:finger
                finger_num="${zero_left * 2}"
                offset_origin_x="${offset_origin_x_const}"
                offset_origin_y="-${offset_origin_y_const}"
                offset_origin_z="${offset_origin_z_const}"
                finger_angle_r="${5.0*DEG2RAD}"
                />
        <!-- THUMB -->
        <xacro:thumb
                finger_num="3"
                offset_origin_x="-0.0182"
                offset_origin_y="${minus_left * 0.019333}"
                offset_origin_z="-0.045987"
                finger_angle_r="0"
                finger_angle_p="-${95*DEG2RAD}"
                finger_angle_y="${minus_right * 90*DEG2RAD}"
                />

        <!-- ================================== SUPPORTS ================================== -->
        <link name="${prefix}_base_screws"/>

        <xacro:if value="${ur5_attachment}">
            <link name="${prefix}_ur5_attachment">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/support/UR5_attachment.stl" scale="0.001 0.001 0.001"/>
                    </geometry>
                    <material name="darker_grey">
                        <color rgba="0.7 0.7 0.7 1"/>
                    </material>
                </visual>

                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/support/UR5_attachment_bottom_collision.stl" scale="0.001 0.001 0.001"/>
                    </geometry>
                </collision>
                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/support/UR5_attachment_top_collision.stl" scale="0.001 0.001 0.001"/>
                    </geometry>
                </collision>

                <inertial>
                    <mass value="0.2"/>
                    <origin xyz="0.000 -0.000 0.015" rpy="0  0  0"/>
                    <inertia ixx="1.01e-04" ixy="-1.20e-5" ixz="3.53e-5" iyy="1.04e-04" iyz="-4.03e-05" izz="1.17e-04"/>
                </inertial>

            </link>
        </xacro:if>

        <xacro:if value="${desk_stand}">
            <link name="${prefix}_desk_stand">
                <visual>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/support/Allegro_deskstand.stl" scale="0.001 0.001 0.001"/>
                    </geometry>
                    <material name="lighter_grey">
                        <color rgba="0.8 0.8 0.8 1"/>
                    </material>
                </visual>

                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/support/Allegro_deskstand_bottom_collision.stl" scale="0.001 0.001 0.001"/>
                    </geometry>
                </collision>
                <collision>
                    <geometry>
                        <mesh filename="file://$(find allegro_hand_description)/meshes/support/Allegro_deskstand_top_collision.stl" scale="0.001 0.001 0.001"/>
                    </geometry>
                </collision>

            <inertial>
                <mass value="0.3"/>
                <origin xyz="0.000 0.000 0.018" rpy="0  0  0"/>
                <inertia ixx="7.09e-04" ixy="-1.32e-5" ixz="1.06e-5" iyy="7.09e-04" iyz="6.26e-5" izz="8.20e-04"/>
            </inertial>

            </link>
        </xacro:if>


        <!-- ================================== ORIGIN ================================== -->
        <joint name="${prefix}_base_screws_joint" type="fixed">
            <parent link="${prefix}_base_screws"/>
            <child link="${prefix}_palm_link"/>
            <origin rpy="0 0 ${90*DEG2RAD}" xyz="0 ${-palm_link_x} ${palm_link_z}"/>
        </joint>

        <!-- Desk stand -->
        <xacro:if value="${desk_stand}">
            <joint name="${prefix}_parent_joint" type="fixed">
                <parent link="${parent}"/>
                <child link="${prefix}_desk_stand"/>
                <xacro:insert_block name="origin"/>
            </joint>
            <joint name="${prefix}_desk_stand_joint" type="fixed">
                <parent link="${prefix}_desk_stand"/>
                <child link="${prefix}_base_screws"/>
                <origin rpy="0 0 0" xyz="0 0 0.119"/>
            </joint>

            <!-- And ur5 attachment -->
            <xacro:if value="${ur5_attachment}">
                <joint name="${prefix}_ur5_attachment_joint" type="fixed">
                    <parent link="${prefix}_base_screws"/>
                    <child link="${prefix}_ur5_attachment"/>
                    <origin rpy="0 0 0" xyz="0 0 -0.05"/>
                </joint>

            </xacro:if>
        </xacro:if>
        <!-- No desk stand -->
        <xacro:unless value="${desk_stand}">
            <!-- But UR5 attachmet -->
            <xacro:if value="${ur5_attachment}">
                <joint name="${prefix}_ur5_attachment_joint" type="fixed">
                    <parent link="${prefix}_ur5_attachment"/>
                    <child link="${prefix}_base_screws"/>
                    <origin rpy="0 0 0" xyz="0 0 0.05"/>
                </joint>
                <joint name="${prefix}_parent_joint" type="fixed">
                    <parent link="${parent}"/>
                    <child link="${prefix}_ur5_attachment"/>
                    <xacro:insert_block name="origin"/>
                </joint>

            </xacro:if>
            <!-- Nothing -->
            <xacro:unless value="${ur5_attachment}">
                <joint name="${prefix}_parent_joint" type="fixed">
                    <parent link="${parent}"/>
                    <child link="${prefix}_base_screws"/>
                    <xacro:insert_block name="origin"/>
                </joint>
            </xacro:unless>
        </xacro:unless>
        <!-- ================================ ROS2 CONTROL =============================== -->

        <xacro:allegro_hand_ros2_control name="allegro_hand" prefix="${prefix}" initial_positions_file="${init_pos_file}" use_real_hardware="${real_hardware}"/>

        <!-- ============================= GAZEBO SIMULATION ============================= -->

        <xacro:if value="${standalone}">
            <gazebo>
                <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <parameters>$(find allegro_hand_controllers)/config/default_pos_controller.yaml</parameters>
                </plugin>
            </gazebo>
        </xacro:if>

    </xacro:macro>
</robot>
